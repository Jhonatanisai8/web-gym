---
import { ArrowRight, Flame, CheckCircle2, ShieldCheck, Sparkles } from 'lucide-astro';

const navItems = [
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Clases', href: '#clases' },
  { label: 'Membresías', href: '#membresias' },
];

const heroImages = [
  {
    src: '/images/hero-1.webp',
    alt: 'Instalaciones y equipamiento de alta gama en IS1998',
  },
  {
    src: '/images/hero-2.webp',
    alt: 'Atleta entrenando halterofilia y levantamiento',
  },
  {
    src: '/images/hero-3.webp',
    alt: 'Entrenamiento de fuerza y alta intensidad',
  },
  {
    src: '/images/hero-4.webp',
    alt: 'Acondicionamiento físico y potencia muscular',
  },
  {
    src: '/images/hero-5.webp',
    alt: 'Sesión de potencia en racks de entrenamiento',
  },
];
---

<section id="hero-editorial" class="relative w-full min-h-screen lg:h-screen lg:max-h-screen bg-brand-dark flex flex-col justify-between overflow-hidden border-b border-brand-emerald/20">
  
  <!-- Main 50/50 Split Viewport -->
  <div class="w-full flex-1 grid grid-cols-1 lg:grid-cols-12 min-h-0">
    
    <!-- ========================================== -->
    <!-- LEFT COLUMN: Typography & Authority Box   -->
    <!-- ========================================== -->
    <div class="lg:col-span-6 flex flex-col justify-between px-6 sm:px-10 lg:px-14 xl:px-16 pt-6 sm:pt-8 pb-6 bg-brand-dark relative z-20 border-r border-brand-emerald/20">
      
      <!-- Top Left: Minimalist Typographic Logo -->
      <div class="flex items-center justify-between lg:justify-start">
        <a href="#" class="group flex items-baseline gap-2.5">
          <span class="font-display font-light text-2xl sm:text-3xl tracking-tight text-white group-hover:text-brand-volt transition-colors">
            IS1998
          </span>
          <span class="font-display font-normal text-2xl sm:text-3xl tracking-tight text-zinc-300 group-hover:text-white transition-colors">
            Athletica<span class="text-brand-volt font-mono font-bold text-lg inline-block align-top ml-0.5">°</span>
          </span>
        </a>

        <!-- Mobile-only quick menu toggle -->
        <a
          href="#membresias"
          class="lg:hidden flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-brand-surface border border-brand-emerald text-xs font-mono text-brand-volt"
          aria-label="Ver membresías"
        >
          <span class="w-2 h-2 rounded-full bg-brand-volt animate-ping"></span>
          <span>Membresías</span>
        </a>
      </div>

      <!-- Center Copy Area: Editorial Headline & Dual CTA -->
      <div class="my-auto max-w-xl py-6">
        
        <!-- Editorial Headline with Oval Outlined Word (Single Motivational Statement) -->
        <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-light text-white leading-[1.12] tracking-tight mb-8">
          Haz que tu cuerpo sea más fuerte que tus{' '}
          <span class="inline-flex items-center justify-center px-4 sm:px-5 py-0.5 my-1 border border-brand-volt text-brand-volt rounded-full font-serif italic font-normal text-[0.92em] shadow-volt-glow transform -rotate-1 align-baseline transition-transform duration-300 hover:rotate-0 hover:scale-105 cursor-pointer">
            excusas
          </span>.
        </h1>

        <!-- Single High-Converting CTA Button -->
        <div class="pt-2">
          <a
            href="#membresias"
            class="group inline-flex items-center justify-center gap-3 px-9 py-4 rounded-full bg-brand-volt text-brand-dark hover:bg-white font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-300 shadow-xl shadow-brand-volt/25 hover:shadow-volt-glow transform hover:-translate-y-0.5 active:scale-95"
          >
            <span>Únete al Club Ahora</span>
            <ArrowRight class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-200" />
          </a>
        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- RIGHT COLUMN: Full-Height Visual Media     -->
    <!-- ========================================== -->
    <div class="lg:col-span-6 relative min-h-[400px] lg:min-h-0 h-full flex flex-col justify-between overflow-hidden bg-brand-surface">
      
      <!-- Background High-Res Carousel Images -->
      <div class="absolute inset-0 z-0">
        {heroImages.map((img, idx) => (
          <img
            src={img.src}
            alt={img.alt}
            class={`hero-carousel-slide absolute inset-0 w-full h-full object-cover object-center filter contrast-105 brightness-95 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
            loading={idx === 0 ? 'eager' : 'lazy'}
            fetchpriority={idx === 0 ? 'high' : 'auto'}
          />
        ))}
        <!-- Subtle warm architectural lighting gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/20 to-brand-dark/40 z-10 pointer-events-none"></div>
        <div class="absolute inset-0 bg-black/20 z-10 pointer-events-none"></div>
      </div>

      <!-- Top Right: Seamless Header Navigation Floating Over Image -->
      <div class="relative z-20 px-6 sm:px-10 lg:px-12 pt-8 flex items-center justify-end gap-6 sm:gap-8">
        <!-- Desktop Nav Items -->
        <nav class="hidden sm:flex items-center gap-7">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="relative text-xs font-semibold text-white/90 hover:text-brand-volt tracking-wider uppercase transition-colors duration-200 py-1 group drop-shadow-md"
            >
              <span>{item.label}</span>
              <span class="absolute bottom-0 left-0 w-full h-0.5 bg-brand-volt scale-x-0 group-hover:scale-x-100 transition-transform duration-200 ease-out origin-left"></span>
            </a>
          ))}
        </nav>

        <!-- Pill Hamburger Menu Button with Red/Volt Dot -->
        <a
          href="#membresias"
          class="group inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/90 hover:bg-white text-brand-dark backdrop-blur-md border border-white/40 shadow-lg hover:shadow-volt-glow transition-all duration-200 transform hover:-translate-y-0.5 active:scale-95"
          aria-label="Abrir opciones de membresía"
        >
          <div class="flex flex-col gap-1 w-4">
            <span class="w-full h-0.5 bg-brand-dark rounded-full transition-transform duration-200 group-hover:scale-x-90"></span>
            <span class="w-full h-0.5 bg-brand-dark rounded-full transition-transform duration-200"></span>
          </div>
          <!-- Live indicator dot -->
          <span class="w-2 h-2 rounded-full bg-brand-volt border border-brand-dark shadow-sm animate-pulse"></span>
        </a>
      </div>

      <!-- Bottom Carousel Indicators -->
      <div class="relative z-20 px-6 sm:px-10 lg:px-12 pb-8 flex items-center justify-end gap-2">
        <div class="flex items-center gap-2 p-1.5 rounded-full bg-brand-dark/60 backdrop-blur-md border border-white/10">
          {heroImages.map((_, idx) => (
            <button
              type="button"
              class={`carousel-indicator h-1.5 rounded-full transition-all duration-500 cursor-pointer ${idx === 0 ? 'w-6 bg-brand-volt shadow-volt-glow' : 'w-2 bg-white/30 hover:bg-white/60'}`}
              data-index={idx}
              aria-label={`Ver imagen ${idx + 1}`}
            />
          ))}
        </div>
      </div>

    </div>

  </div>

</section>

<script>
  function initHeroCarousel() {
    const slides = document.querySelectorAll<HTMLImageElement>('.hero-carousel-slide');
    const indicators = document.querySelectorAll<HTMLButtonElement>('.carousel-indicator');
    if (!slides.length) return;

    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;

    function goToSlide(index: number) {
      slides[currentIndex].classList.remove('opacity-100');
      slides[currentIndex].classList.add('opacity-0');
      
      if (indicators[currentIndex]) {
        indicators[currentIndex].classList.remove('w-6', 'bg-brand-volt', 'shadow-volt-glow');
        indicators[currentIndex].classList.add('w-2', 'bg-white/30');
      }

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.remove('opacity-0');
      slides[currentIndex].classList.add('opacity-100');

      if (indicators[currentIndex]) {
        indicators[currentIndex].classList.remove('w-2', 'bg-white/30');
        indicators[currentIndex].classList.add('w-6', 'bg-brand-volt', 'shadow-volt-glow');
      }
    }

    function startAutoPlay() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 4000);
    }

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        const targetIndex = Number(indicator.dataset.index);
        if (!isNaN(targetIndex)) {
          goToSlide(targetIndex);
          startAutoPlay();
        }
      });
    });

    startAutoPlay();
  }

  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
