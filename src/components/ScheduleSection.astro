---
import { Clock, Dumbbell, Activity, Bike, Sparkles, ArrowRight, Calendar, UserCheck } from 'lucide-astro';

const classes = [
  {
    title: 'Athletic Conditioning & Hyrox',
    category: 'Rendimiento & Fuerza',
    badge: 'Popular',
    schedule: 'Lunes a Sábado · 06:30, 08:00 y 18:30 hrs',
    coach: 'Coaches Certificados CSCS®',
    description: 'Entrenamiento funcional de alta intensidad combinando ergómetros Concept2, trineos magnéticos y ejercicios con peso corporal.',
    image: '/images/clase-hyrox.webp',
    icon: Activity,
  },
  {
    title: 'Olympic Weightlifting',
    category: 'Fuerza Pura',
    badge: 'Biomecánica',
    schedule: 'Lunes a Viernes · 07:00, 12:30 y 19:00 hrs',
    coach: 'Especialistas en Halterofilia',
    description: 'Técnica de precisión en barra olímpica, sentadilla, arranque y envión con micro-ajustes biomecánicos individualizados.',
    image: '/images/clase-weightlifting.webp',
    icon: Dumbbell,
  },
  {
    title: 'Sound Cycling: Power Zones',
    category: 'Cardio de Precisión',
    badge: 'Inmersivo',
    schedule: 'Lunes a Domingo · Sesiones en mañana y noche',
    coach: 'Instructores Master Keiser',
    description: 'Ciclismo indoor con bicicletas Keiser M3i, medición de vatios en tiempo real, iluminación adaptativa y audio acústico envolvente.',
    image: '/images/clase-cycling.webp',
    icon: Bike,
  },
  {
    title: 'Mobility & Recovery Sanctuary',
    category: 'Bienestar & Salud',
    badge: 'Recuperación',
    schedule: 'Tardes y fines de semana · Horarios flexibles',
    coach: 'Fisioterapeutas Colegiados',
    description: 'Descompresión articular, estiramientos asistidos, respiración guiada y acceso libre al sauna seco para acelerar tu regeneración física.',
    image: '/images/clase-mobility.webp',
    icon: Sparkles,
  },
];

const generalHours = [
  { label: 'Lunes a Viernes', time: '05:00 - 23:00 hrs' },
  { label: 'Sábados', time: '07:00 - 20:00 hrs' },
  { label: 'Domingos & Feriados', time: '08:00 - 14:00 hrs' },
];
---

<section id="clases" class="py-24 bg-brand-dark relative border-t border-brand-emerald/20 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-white uppercase tracking-tight leading-tight mb-4">
        Entrena con los Mejores. <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-volt to-emerald-400">En Tu Horario.</span>
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base leading-relaxed font-light">
        Programación semanal diseñada para adaptarse a tu ritmo. Clases de grupos reducidos con seguimiento técnico profesional en cada sesión.
      </p>
    </div>

    <!-- Flagship Classes Showcase (4 in a Row) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {classes.map((item) => {
        const IconComponent = item.icon;
        return (
          <div class="group relative rounded-3xl bg-brand-surface/80 border border-brand-emerald/30 hover:border-brand-volt/60 transition-all duration-300 overflow-hidden shadow-xl flex flex-col justify-between hover:-translate-y-1 hover:shadow-volt-glow/15">
            
            <!-- Top Visual Image (Aspect Ratio 4:3) -->
            <div class="relative aspect-[4/3] w-full overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover filter contrast-105 brightness-90 group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-surface via-brand-surface/30 to-transparent"></div>
              
              <!-- Floating Category Tag -->
              <div class="absolute top-3 left-3 flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-dark/85 backdrop-blur-md border border-brand-emerald/70 text-[11px] font-mono font-semibold text-brand-volt shadow-md">
                  <IconComponent class="w-3 h-3 text-brand-volt" />
                  {item.category}
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between relative z-10 bg-brand-surface/90">
              <div>
                <h3 class="font-display font-bold text-lg sm:text-xl text-white tracking-tight mb-2.5 group-hover:text-brand-volt transition-colors leading-snug">
                  {item.title}
                </h3>
                
                <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed font-light mb-5">
                  {item.description}
                </p>

                <!-- Schedule & Coach Badges -->
                <div class="space-y-2 pt-3 border-t border-zinc-800/80 mb-5">
                  <div class="flex items-center gap-2 text-[11px] text-zinc-300">
                    <Clock class="w-3.5 h-3.5 text-brand-volt flex-shrink-0" />
                    <span>{item.schedule}</span>
                  </div>
                  <div class="flex items-center gap-2 text-[11px] text-zinc-400 font-light">
                    <UserCheck class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" />
                    <span>{item.coach}</span>
                  </div>
                </div>
              </div>

              <!-- Action Link -->
              <div class="pt-2 border-t border-zinc-800/60">
                <a
                  href="#membresias"
                  class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-volt hover:text-white transition-colors group/link"
                >
                  <span>Ver Planes</span>
                  <ArrowRight class="w-3.5 h-3.5 transform group-hover/link:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>

            <!-- Bottom Hover Line -->
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-brand-volt/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          </div>
        );
      })}
    </div>

    <!-- General Club Hours Bar -->
    <div class="rounded-2xl bg-brand-surface/60 border border-brand-emerald/30 p-6 sm:p-8 flex flex-col lg:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="flex items-center gap-4 text-center lg:text-left">
        <div class="w-12 h-12 rounded-xl bg-brand-dark border border-brand-volt/40 text-brand-volt flex items-center justify-center flex-shrink-0 shadow-md">
          <Calendar class="w-6 h-6" />
        </div>
        <div>
          <h4 class="font-display font-bold text-lg text-white tracking-tight">Horarios Generales del Club</h4>
          <p class="text-xs text-zinc-400 font-light mt-0.5">Acceso libre ilimitado para socios en todas las franjas horarias.</p>
        </div>
      </div>

      <!-- Schedule Pills -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        {generalHours.map((h) => (
          <div class="px-4 py-2 rounded-xl bg-brand-dark/80 border border-zinc-800 text-center">
            <span class="block text-[10px] font-mono uppercase text-zinc-400">{h.label}</span>
            <span class="block text-xs font-bold text-brand-volt mt-0.5">{h.time}</span>
          </div>
        ))}
      </div>

      <!-- CTA Button -->
      <div>
        <a
          href="#membresias"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-volt text-brand-dark hover:bg-white font-extrabold text-xs uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-volt-glow transform active:scale-95 whitespace-nowrap"
        >
          <span>Elegir mi Plan</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>

  </div>
</section>
