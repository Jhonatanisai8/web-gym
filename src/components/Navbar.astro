---
import { Menu, X, ArrowRight, ArrowUpRight } from 'lucide-astro';

const navLinks = [
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Clases', href: '#clases' },
  { label: 'Membresías', href: '#membresias' },
  { label: 'Sedes', href: '#sedes' },
];
---

<!-- Modern Floating Glassmorphic Sticky Header -->
<header
  id="global-sticky-header"
  class="fixed top-4 inset-x-0 z-50 flex flex-col items-center px-4 transition-all duration-300 ease-out transform -translate-y-16 opacity-0 pointer-events-none"
>
  <div class="w-full max-w-5xl rounded-full bg-brand-dark/85 backdrop-blur-2xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.85),0_0_30px_rgba(199,255,58,0.08)] px-4 sm:px-6 py-2.5 flex items-center justify-between pointer-events-auto">
    
    <!-- Brand Logo -->
    <a href="#" class="group flex items-baseline gap-1.5 py-1">
      <span class="font-display font-black text-lg tracking-wider text-white uppercase group-hover:text-brand-volt transition-colors">
        IS1998
      </span>
      <span class="text-[9px] font-mono tracking-widest text-brand-volt font-bold hidden sm:inline-block">
        PRO
      </span>
    </a>

    <!-- Desktop Nav Links (Centered Pills) -->
    <nav class="hidden md:flex items-center gap-1 bg-brand-surface/60 border border-white/5 rounded-full px-2 py-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-xs font-semibold text-zinc-300 hover:text-white px-3.5 py-1.5 rounded-full hover:bg-white/10 transition-all duration-200 tracking-wider uppercase"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (CTA + Mobile Trigger) -->
    <div class="flex items-center gap-2.5">
      <!-- High-converting CTA Button -->
      <a
        href="#membresias"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-full bg-brand-volt text-brand-dark hover:bg-white font-black text-xs uppercase tracking-wider transition-all duration-200 shadow-md shadow-brand-volt/20 hover:shadow-volt-glow transform hover:-translate-y-0.5 active:scale-[0.98]"
      >
        <span>Únete al Club</span>
        <ArrowRight class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="sticky-mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-full bg-brand-surface border border-zinc-800 text-zinc-300 hover:text-brand-volt hover:border-brand-volt transition-colors focus:outline-none"
        aria-label="Abrir menú"
      >
        <Menu id="sticky-menu-icon" class="w-5 h-5" />
        <X id="sticky-close-icon" class="w-5 h-5 hidden" />
      </button>
    </div>

  </div>

  <!-- Mobile Floating Drawer Dropdown -->
  <div
    id="sticky-mobile-menu"
    class="hidden md:hidden w-full max-w-md mt-2.5 rounded-2xl bg-brand-dark/95 backdrop-blur-2xl border border-white/10 p-5 shadow-2xl pointer-events-auto"
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="sticky-mobile-nav-link text-sm font-semibold text-zinc-200 hover:text-brand-volt px-4 py-2.5 rounded-xl hover:bg-white/5 transition-colors flex items-center justify-between"
        >
          <span>{link.label}</span>
          <ArrowUpRight class="w-4 h-4 text-zinc-500" />
        </a>
      ))}
      <div class="pt-3 border-t border-zinc-800/80 mt-2">
        <a
          href="#membresias"
          class="sticky-mobile-nav-link w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-brand-volt text-brand-dark font-extrabold text-xs uppercase tracking-wider hover:bg-white transition-all shadow-volt-glow"
        >
          <span>Únete al Club</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function initStickyNavbar() {
    const header = document.getElementById('global-sticky-header');
    const mobileBtn = document.getElementById('sticky-mobile-menu-btn');
    const mobileMenu = document.getElementById('sticky-mobile-menu');
    const menuIcon = document.getElementById('sticky-menu-icon');
    const closeIcon = document.getElementById('sticky-close-icon');
    const mobileLinks = document.querySelectorAll('.sticky-mobile-nav-link');

    // Scroll listener to show floating header after scrolling
    window.addEventListener('scroll', () => {
      if (window.scrollY > 250) {
        header?.classList.remove('-translate-y-16', 'opacity-0', 'pointer-events-none');
        header?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      } else {
        header?.classList.add('-translate-y-16', 'opacity-0', 'pointer-events-none');
        header?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    }, { passive: true });

    if (mobileBtn && mobileMenu && menuIcon && closeIcon) {
      mobileBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.contains('hidden');
        if (isHidden) {
          mobileMenu.classList.remove('hidden');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        });
      });
    }
  }

  initStickyNavbar();
  document.addEventListener('astro:page-load', initStickyNavbar);
</script>
