---
import { MapPin, Phone, Clock, Car, Coffee, Wifi, Sparkles, Navigation } from 'lucide-astro';

const locations = [
  {
    name: 'Sede Central · San Isidro',
    address: 'Av. Las Begonias 450, Centro Financiero',
    district: 'San Isidro, Lima',
    phone: '+51 (01) 640-9280',
    hours: 'Lun a Vie: 05:00 - 23:00 · Sáb: 07:00 - 20:00 · Dom: 08:00 - 14:00',
    image: '/images/sede-san-isidro.webp',
    features: ['Valet Parking gratuito', 'Cafetería de Especialidad & Proteínas', 'Sauna Finlandés & Tinas 3°C', 'Plataformas Eleiko IWF'],
    mapLink: 'https://maps.google.com',
  },
  {
    name: 'Sede Boutique · Miraflores',
    address: 'Av. Santa Cruz 880, Zona Embajadas',
    district: 'Miraflores, Lima',
    phone: '+51 (01) 640-9281',
    hours: 'Lun a Vie: 05:30 - 22:30 · Sáb: 07:00 - 19:00 · Dom: 08:00 - 14:00',
    image: '/images/sede-miraflores.webp',
    features: ['Estacionamiento subterráneo', 'Estudio Void Sound Cycling', 'Crioterapia & Masajes Deportivos', 'Terraza Lounge para Coworking'],
    mapLink: 'https://maps.google.com',
  },
];
---

<section id="sedes" class="py-24 bg-brand-dark relative border-t border-brand-emerald/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
      <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-white uppercase tracking-tight leading-tight mb-4">
        Nuestras Sedes <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-volt to-emerald-400">Boutique</span>
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
        Ubicadas en los distritos neurálgicos, con estacionamiento propio, acceso biometrico y todos los servicios para tu jornada profesional.
      </p>
    </div>

    <!-- Locations Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {locations.map((loc, idx) => (
        <div
          class="rounded-2xl bg-brand-surface border border-brand-emerald/40 hover:border-brand-volt/60 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-2xl overflow-hidden flex flex-col group"
          data-reveal
          data-reveal-delay={idx * 150}
        >
          
          <!-- Image Header -->
          <div class="relative h-60 w-full overflow-hidden">
            <img
              src={loc.image}
              alt={loc.name}
              class="w-full h-full object-cover filter contrast-105 brightness-90 group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-surface via-brand-surface/30 to-transparent"></div>
            
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-dark/90 backdrop-blur-md border border-brand-emerald text-xs font-mono font-bold text-white">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Abierto Ahora
              </span>
            </div>
          </div>

          <!-- Body -->
          <div class="p-8 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-display font-bold text-2xl text-white tracking-tight mb-2">
                {loc.name}
              </h3>
              
              <div class="space-y-2 mb-6 text-xs text-zinc-300">
                <div class="flex items-start gap-2">
                  <MapPin class="w-4 h-4 text-brand-volt flex-shrink-0 mt-0.5" />
                  <span>{loc.address} · <span class="text-zinc-400">{loc.district}</span></span>
                </div>
                <div class="flex items-center gap-2">
                  <Clock class="w-4 h-4 text-brand-volt flex-shrink-0" />
                  <span>{loc.hours}</span>
                </div>
                <div class="flex items-center gap-2">
                  <Phone class="w-4 h-4 text-brand-volt flex-shrink-0" />
                  <span>{loc.phone}</span>
                </div>
              </div>

              <!-- Amenity Badges -->
              <div class="pt-4 border-t border-zinc-800/80 mb-6">
                <p class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider mb-3">Amenidades exclusivas:</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {loc.features.map((feat) => (
                    <div class="flex items-center gap-2 text-xs text-zinc-300 bg-brand-dark/50 px-3 py-1.5 rounded-lg border border-zinc-800">
                      <Sparkles class="w-3.5 h-3.5 text-brand-volt flex-shrink-0" />
                      <span>{feat}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center gap-3 pt-2">
              <a
                href="#pase-gratis"
                data-open-pass-modal
                class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-brand-volt text-brand-dark font-black text-xs uppercase tracking-wider hover:bg-white transition-all shadow-sm"
              >
                <span>Probar esta sede</span>
              </a>
              <a
                href={loc.mapLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 p-3 rounded-lg bg-brand-dark border border-brand-emerald text-zinc-300 hover:text-brand-volt hover:border-brand-volt transition-all"
                aria-label="Ver en Google Maps"
              >
                <Navigation class="w-4 h-4" />
              </a>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
